[Unit]
Description=GSM AI Caller - agent
After=network-online.target asterisk.service ollama.service
Wants=network-online.target

[Service]
User=aicaller
WorkingDirectory=/opt/gsm-ai-caller
Environment=CALLER_CONFIG=/opt/gsm-ai-caller/config.yaml
ExecStart=/opt/gsm-ai-caller/venv/bin/python -m caller agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
